# ==============================================================================
# DEW & GO - BEAUTY QUICK-COMMERCE PLATFORM
# Production & Development Environment Configuration
# ==============================================================================

# Supabase Public Configuration (Browser safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase Server-Only Configuration (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway Configuration
# Test mode keys start with: rzp_test_
# Live mode keys start with: rzp_live_
RAZORPAY_KEY_ID=rzp_test_DewAndGoTestId
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email Configuration (Resend, SendGrid, or AWS SES)
TRANSACTIONAL_EMAIL_API_KEY=re_your_transactional_email_key
TRANSACTIONAL_EMAIL_FROM=orders@dewandgo.com

# Application Base Settings
APP_BASE_URL=http://localhost:5173
SUPPORT_EMAIL=care@dewandgo.com
SUPPORT_PHONE=+91 80000 12345

# Delivery & Hyperlocal Settings
DEFAULT_DELIVERY_MINUTES=15
FREE_DELIVERY_THRESHOLD=499
STANDARD_DELIVERY_FEE=49
STORE_CURRENCY=INR

# Administrator Account Provisioning (Server-Only Configuration)
# Used by scripts/provision-admin.js and api/admin/provision.ts
ADMIN_EMAIL=admin@your-domain.com
ADMIN_INITIAL_PASSWORD=YourSecureAdminPassword123!
ADMIN_FULL_NAME=Store Administrator
ADMIN_PROVISION_SECRET=your_secret_provision_key_here

